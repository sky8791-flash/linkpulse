# Local PostgreSQL example. Docker Compose overrides DATABASE_URL internally.
DATABASE_URL=postgres://linkpulse:linkpulse_dev_password@127.0.0.1:5432/linkpulse_dev?sslmode=disable
API_KEY=local-demo-api-key-123456
BASE_URL=http://localhost:8080
VISITOR_HASH_SECRET=local-demo-visitor-secret-123456
STATS_TIMEZONE=Asia/Shanghai

HTTP_ADDR=:8080
CACHE_SIZE=10000
CACHE_TTL=1m
CLICK_QUEUE_SIZE=4096
CLICK_BATCH_SIZE=100
CLICK_FLUSH_INTERVAL=1s
CLICK_WRITE_RETRIES=3
PUBLIC_RATE_LIMIT=100
PUBLIC_RATE_BURST=200
ADMIN_RATE_LIMIT=20
ADMIN_RATE_BURST=40
SHUTDOWN_TIMEOUT=10s

# Used only by docker-compose.yml.
POSTGRES_PASSWORD=linkpulse_dev_password
